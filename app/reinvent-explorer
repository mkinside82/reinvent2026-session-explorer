#!/bin/zsh
setopt NO_BG_NICE
set -eu

APP_DIR="${0:A:h}"
STATE_DIR="${TMPDIR:-/tmp}/reinvent-session-explorer"
PID_FILE="$STATE_DIR/server.pid"
LOG_FILE="$STATE_DIR/server.log"
BIN="$APP_DIR/server/target/release/reinvent-session-explorer"
MCP_TUNNEL_PROFILE="reinvent-session-explorer"

server_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(<"$PID_FILE")"
  [[ "$pid" == <-> ]] || return 1
  ps -p "$pid" -o command= 2>/dev/null | grep -Fq "$BIN" || return 1
  print -r -- "$pid"
}

case "${1:-help}" in
  start)
    mkdir -p "$STATE_DIR"
    if pid="$(server_pid)"; then
      print -r -- "Session Explorer is already running (pid $pid)."
      cat "$LOG_FILE" 2>/dev/null | grep '^READY ' | tail -n 1 || true
      exit 0
    fi
    if ! command -v cargo >/dev/null; then
      print -u2 "Rust is required. Install it with: brew install rust"
      exit 1
    fi
    (cd "$APP_DIR/server" && cargo build --release)
    nohup env REINVENT_APP_DIR="$APP_DIR" "$BIN" >"$LOG_FILE" 2>&1 </dev/null &
    pid=$!
    disown "$pid" 2>/dev/null || true
    print -r -- "$pid" >"$PID_FILE"
    for _ in {1..50}; do
      if ! kill -0 "$pid" 2>/dev/null; then
        cat "$LOG_FILE"
        rm -f "$PID_FILE"
        exit 1
      fi
      if grep -q '^READY ' "$LOG_FILE" 2>/dev/null; then
        grep '^READY ' "$LOG_FILE" | tail -n 1
        print -r -- "Stop with: $0 stop"
        exit 0
      fi
      sleep 0.2
    done
    print -u2 "The server did not become ready. Diagnostics: $0 diagnostics"
    exit 1
    ;;
  stop)
    if pid="$(server_pid)"; then
      kill -TERM "$pid"
      rm -f "$PID_FILE"
      print -r -- "Stopped Session Explorer (pid $pid)."
    else
      rm -f "$PID_FILE"
      print -r -- "Session Explorer is not running."
    fi
    ;;
  status)
    if pid="$(server_pid)"; then
      print -r -- "Session Explorer is running (pid $pid)."
      grep '^READY ' "$LOG_FILE" 2>/dev/null | tail -n 1 || true
    else
      print -r -- "Session Explorer is stopped."
      exit 1
    fi
    ;;
  diagnostics)
    print -r -- "macOS: $(sw_vers -productVersion 2>/dev/null || print unknown)"
    print -r -- "Node: $(node --version 2>/dev/null || print not-installed)"
    print -r -- "Rust: $(rustc --version 2>/dev/null || print not-installed)"
    print -r -- "Cargo: $(cargo --version 2>/dev/null || print not-installed)"
    "$0" status || true
    if command -v lsof >/dev/null; then
      lsof -nP -iTCP:8484-8489 -sTCP:LISTEN 2>/dev/null || true
    fi
    ;;
  mcp)
    if ! command -v node >/dev/null; then
      print -u2 "Node.js is required to run the local MCP server."
      exit 1
    fi
    if ! server_pid >/dev/null; then
      "$0" start >&2
    fi
    exec node "$APP_DIR/mcp-server.mjs"
    ;;
  mcp-tunnel-setup)
    if [[ -z "${2:-}" ]]; then
      print -u2 "Usage: $0 mcp-tunnel-setup <tunnel_id>"
      exit 2
    fi
    if ! command -v tunnel-client >/dev/null; then
      print -u2 "Install the OpenAI tunnel-client first: https://developers.openai.com/api/docs/guides/secure-mcp-tunnels"
      exit 1
    fi
    if [[ -z "${CONTROL_PLANE_API_KEY:-}" ]]; then
      print -u2 "Set CONTROL_PLANE_API_KEY in your shell environment. Do not put it in the repository."
      exit 1
    fi
    tunnel-client init \
      --sample sample_mcp_stdio_local \
      --profile "$MCP_TUNNEL_PROFILE" \
      --tunnel-id "$2" \
      --mcp-command "$APP_DIR/reinvent-explorer mcp"
    tunnel-client doctor --profile "$MCP_TUNNEL_PROFILE" --explain
    print -r -- "Setup complete. Start the connection with: $0 mcp-tunnel"
    ;;
  mcp-tunnel)
    if ! command -v tunnel-client >/dev/null; then
      print -u2 "Install the OpenAI tunnel-client first: https://developers.openai.com/api/docs/guides/secure-mcp-tunnels"
      exit 1
    fi
    if [[ -z "${CONTROL_PLANE_API_KEY:-}" ]]; then
      print -u2 "Set CONTROL_PLANE_API_KEY in your shell environment. Do not put it in the repository."
      exit 1
    fi
    exec tunnel-client run --profile "$MCP_TUNNEL_PROFILE"
    ;;
  help|*)
    print -r -- "Usage: $0 {start|stop|status|diagnostics|mcp|mcp-tunnel-setup <tunnel_id>|mcp-tunnel}"
    ;;
esac
